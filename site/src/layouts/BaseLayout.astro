---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
const fullTitle = title ? `${title} | NoFrills.news` : 'NoFrills.news';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Minimal news aggregation without the noise" />
    <title>{fullTitle}</title>
  </head>
  <body>
    <nav class="navbar">
      <slot name="nav" />
    </nav>

    <main>
      <slot />
    </main>

    <footer>
      <p>&copy; {new Date().getFullYear()} NoFrills.news • Just the news, no frills</p>
    </footer>
  </body>
</html>
