---
import categories from '../../../data/categories.json';
import { slugify } from '../utils/formatTime';

interface Props {
  activeCategory?: string;
}

const { activeCategory } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<header class="masthead">
  <div class="masthead-inner">
    <div class="masthead-title"><a href={base}>NoFrills.news</a></div>
    <div class="masthead-tagline">No-frills tech news</div>
  </div>
</header>

<nav class="section-nav" aria-label="Categories">
  <div class="section-nav-inner">
    {categories.map((category) => (
      <a
        href={`${base}category/${slugify(category)}/`}
        class={activeCategory && slugify(activeCategory) === slugify(category) ? "active" : ""}
      >
        {category}
      </a>
    ))}
  </div>
</nav>
