---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';
import { formatRelativeTime, slugify } from '../../utils/formatTime';
import type { GetStaticPaths } from 'astro';
import articles from '../../../../data/articles.json';

export const getStaticPaths = (async () => {
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article }
  }));
}) satisfies GetStaticPaths;

interface Props {
  article: {
    id: number;
    title: string;
    source_url: string;
    source_name?: string;
    summary: string;
    category: string;
    published_date: string;
    slug: string;
  };
}

const { article } = Astro.props;
const base = import.meta.env.BASE_URL;
const categorySlug = slugify(article.category);

// Format date for display
function formatDate(dateString: string): string {
  const date = new Date(dateString);
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
}

// Get related articles from the same category (excluding current, max 4)
const sortedArticles = [...articles]
  .filter((a) => a.category === article.category && a.slug !== article.slug)
  .sort((a, b) => new Date(b.published_date).getTime() - new Date(a.published_date).getTime())
  .slice(0, 4);
---

<BaseLayout title={article.title} activeCategory={article.category}>

  <div class="back-nav">
    <a href={`${base}category/${categorySlug}/`}>&larr; {article.category}</a>
  </div>

  <div class="article-layout">
    <div class="article-reading-column">
      <header class="article-header">
        <div class="article-category">
          <a href={`${base}category/${categorySlug}/`}>{article.category}</a>
        </div>
        <h1 class="article-detail-title">{article.title}</h1>
        <div class="article-byline">
          <span>{formatDate(article.published_date)}</span>
          {article.source_name && (
            <>
              <span class="sep">&middot;</span>
              <span>via {article.source_name}</span>
            </>
          )}
        </div>
      </header>

      <div class="article-body">
        {article.summary.split('\n').filter(p => p.trim()).map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>

      <div class="source-link-container">
        <div class="source-link-label">Read the original article</div>
        <a
          class="source-link"
          href={article.source_url}
          target="_blank"
          rel="noopener noreferrer"
        >
          {article.source_name || article.source_url} &rarr;
        </a>
      </div>
    </div>

    <RelatedArticles
      articles={sortedArticles}
      categoryName={article.category}
      categorySlug={categorySlug}
    />
  </div>

</BaseLayout>
